# Existing stable Gemini path
MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_existing_stable_gemini_key
GOOGLE_API_KEY=
VLM_MODEL=gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash
MODEL_GROUP=

