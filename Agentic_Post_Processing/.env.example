# VLM/classification settings for the PC-side processing pipeline.
# Copy to Agentic_Post_Processing/.env and fill in one provider.

# OpenAI-compatible gateway
MODEL_PROVIDER=openai_compatible
VLM_MODEL=gpt-4o
OPENAI_BASE_URL=https://<gateway-host>/v1
OPENAI_API_KEY=<your-api-key>

# Gemini alternative
# MODEL_PROVIDER=gemini
# VLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=<your-api-key>

MAX_EVAL_ITERATIONS=3
QUALITY_THRESHOLD=0.75

# Optional high-level decision escalation path via gateway.
DECISION_MODEL_ENABLED=0
DECISION_MODEL=gpt-5-mini
DECISION_MODEL_GROUP=
DECISION_MODEL_FALLBACK=gpt-5.1-chat
DECISION_MODEL_FALLBACK_GROUP=
DECISION_MODEL_EXPERT=gpt-5-pro
DECISION_MODEL_EXPERT_GROUP=
DECISION_SCORE_TRIGGER=0.55
DECISION_MIN_ITERATION=2
