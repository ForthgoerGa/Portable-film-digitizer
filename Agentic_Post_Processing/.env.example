# Unified gateway configuration
MODEL_PROVIDER=openai_compatible
OPENAI_API_KEY=your_gateway_key_here
OPENAI_BASE_URL=https://yinli.one/v1

# Recommended defaults tested in this environment
VLM_MODEL=gpt-4.1-mini
LLM_MODEL=gpt-4.1-mini

# Leave empty for the first gateway key
MODEL_GROUP=

# Optional Gemini fallback
GEMINI_API_KEY=
GOOGLE_API_KEY=

MAX_EVAL_ITERATIONS=3
QUALITY_THRESHOLD=0.75
