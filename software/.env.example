# PC-side server deployment settings.
# Copy to software/.env and edit for the active network before running.

PC_SERVER_HOST=0.0.0.0
PC_SERVER_PORT=8000

# URL reachable from the Raspberry Pi. This changes when hotspot/Ethernet
# addresses change. Example: http://10.12.194.14:8000
PC_APP_URL=http://<pc-ip>:8000

# Pi scanner server and optional legacy camera server.
PI_SCANNER_URL=http://<pi-ip>:5000
PI_CAMERA_URL=http://<pi-ip>:8080

# SSH deployment path metadata. Do not put passwords in this file.
PI_SSH_HOST=rpi.local
PI_SSH_USER=arnav
PI_PROJECT_ROOT=/home/arnav/ece-445-film-digitizer
PI_SERVER_WORKDIR=/home/arnav/ece-445-film-digitizer/software/src

# Processing/runtime tuning.
TILE_PROCESS_WORKERS=2
FAST_PREVIEW_MAX_SIDE=1600
FAST_PREVIEW_FLAT_FIELD=1
BASE_BBOX_DETECTOR=cv_edge
BASE_BBOX_CONFIDENCE_THRESHOLD=0.25
PROCESSED_TILE_OVERLAP_REFINEMENT=1
